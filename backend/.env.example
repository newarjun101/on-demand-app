# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# CORS - which frontends are allowed
CUSTOMER_WEB_URL=http://localhost:5173
WORKER_WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL
DATABASE_URL=postgresql://lsm:lsm_password@localhost:5432/lsm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev_jwt_secret_change_me_change_me_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_change_me_change
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Business
PLATFORM_COMMISSION_PERCENT=10
DEFAULT_CURRENCY=MMK